<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ system splash: the logo on the aubergine room. -->
    <style name="Theme.pocketlibrary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/pocketlibrary_aubergine</item>
        <item name="android:navigationBarColor">@color/pocketlibrary_aubergine</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/pocketlibrary_aubergine</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/pocketlibrary_aubergine</item>
    </style>
</resources>
