{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PocketLibrary",
  "version": "0.1.6",
  "identifier": "app.pocketlibrary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PocketLibrary",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' blob:; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwOEI0RDZGRUNGRjhBOEYKUldTUGl2L3NiMDJMME9SMDZCMUVIR2puTkttMk9BY0E3d0YzWkYzQklIS29GZmorbWMxeW56WWoK",
      "endpoints": [
        "https://github.com/YeahItsMeAgain/PocketLibrary/releases/latest/download/latest.json"
      ]
    }
  }
}
